{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/schemas/graph-studio-preset.v1.schema.json",
  "title": "Mere Graph Studio preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "title", "created_at", "nodes", "positions"],
  "properties": {
    "contract_version": {"const": "mere.run/graph-studio-preset.v1"},
    "id": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "workflow-graph.v1.schema.json#/$defs/node"}},
    "positions": {"$ref": "workflow-editor-sidecar.v1.schema.json#/properties/nodes"}
  }
}
