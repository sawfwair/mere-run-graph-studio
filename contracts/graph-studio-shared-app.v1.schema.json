{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/schemas/graph-studio-shared-app.v1.schema.json",
  "title": "Mere Graph Studio shared app v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "token", "path", "title", "created_at", "graph", "inputs", "sidecar"],
  "properties": {
    "contract_version": {"const": "mere.run/graph-studio-shared-app.v1"},
    "token": {"type": "string", "format": "uuid"},
    "path": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "graph": {"$ref": "workflow-graph.v1.schema.json"},
    "inputs": {"type": "object"},
    "sidecar": {"$ref": "workflow-editor-sidecar.v1.schema.json"}
  }
}
