{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/workflow-editor-sidecar.v1.schema.json",
  "title": "mere.run Workflow Editor Sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "viewport", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "mere.run/workflow-editor"},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "zoom": {"type": "number", "minimum": 0.1, "maximum": 4}
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "collapsed": {"type": "boolean"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "collapsed": {"type": "boolean"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "collapsed": {"type": "boolean"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "width", "height", "title", "node_ids"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"type": "number", "minimum": 120},
          "height": {"type": "number", "minimum": 80},
          "title": {"type": "string"},
          "node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
          "collapsed": {"type": "boolean"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "notes": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "width", "height", "text"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"type": "number", "minimum": 120},
          "height": {"type": "number", "minimum": 80},
          "text": {"type": "string"},
          "collapsed": {"type": "boolean"},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "selection_sets": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_ids"],
        "properties": {
          "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
        }
      }
    },
    "promotions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer_id", "argument_name", "consumer_position"],
        "properties": {
          "consumer_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "argument_name": {"type": "string"},
          "consumer_position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          }
        }
      }
    },
    "board": {
      "type": "array",
      "maxItems": 100,
      "description": "Saved references to verified run artifacts for comparison. Never contains media bytes or secret values.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node_id", "run_id", "path", "name", "created_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "run_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"},
          "content_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "model": {"type": "string"},
          "seed": {"type": "string"}
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "description": "Editor-only presentation for Run-as-App: which graph inputs are exposed as fields, their order and labels, and app framing. Never affects execution.",
      "properties": {
        "title": {"type": "string"},
        "tagline": {"type": "string"},
        "fields": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hidden": {"type": "boolean"},
              "locked": {"type": "boolean"},
              "label": {"type": "string"},
              "order": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
